// 基础 NEON 内积（朴素 SIMD）
// 每次处理 4 个 float（128 位），使用单个累加器
inline float inner_product_neon(const float* a, const float* b, size_t d) {
    float32x4_t sum_vec = vdupq_n_f32(0.0f);
    size_t i = 0;
    for (; i + 4 <= d; i += 4) {
        float32x4_t va = vld1q_f32(a + i);
        float32x4_t vb = vld1q_f32(b + i);
        sum_vec = vmlaq_f32(sum_vec, va, vb);
    }
    float sum = vaddvq_f32(sum_vec);
    for (; i < d; ++i) sum += a[i] * b[i];
    return 1.0f - sum;
}

// 循环展开 2 倍 
// 一次处理 8 个 float，使用两个累加器以减少依赖
inline float inner_product_neon_unroll2(const float* a, const float* b, size_t d) {
    float32x4_t sum1 = vdupq_n_f32(0.0f);
    float32x4_t sum2 = vdupq_n_f32(0.0f);
    size_t i = 0;
    for (; i + 8 <= d; i += 8) {
        float32x4_t va1 = vld1q_f32(a + i);
        float32x4_t vb1 = vld1q_f32(b + i);
        float32x4_t va2 = vld1q_f32(a + i + 4);
        float32x4_t vb2 = vld1q_f32(b + i + 4);
        sum1 = vmlaq_f32(sum1, va1, vb1);
        sum2 = vmlaq_f32(sum2, va2, vb2);
    }
    float32x4_t sum = vaddq_f32(sum1, sum2);
    float total = vaddvq_f32(sum);
    for (; i < d; ++i) total += a[i] * b[i];
    return 1.0f - total;
}

// 循环展开 4 倍 
// 一次处理 16 个 float，使用四个累加器，最大化指令级并行
inline float inner_product_neon_unroll4(const float* a, const float* b, size_t d) {
    float32x4_t sum1 = vdupq_n_f32(0.0f);
    float32x4_t sum2 = vdupq_n_f32(0.0f);
    float32x4_t sum3 = vdupq_n_f32(0.0f);
    float32x4_t sum4 = vdupq_n_f32(0.0f);
    size_t i = 0;
    for (; i + 16 <= d; i += 16) {
        float32x4_t va1 = vld1q_f32(a + i);
        float32x4_t vb1 = vld1q_f32(b + i);
        float32x4_t va2 = vld1q_f32(a + i + 4);
        float32x4_t vb2 = vld1q_f32(b + i + 4);
        float32x4_t va3 = vld1q_f32(a + i + 8);
        float32x4_t vb3 = vld1q_f32(b + i + 8);
        float32x4_t va4 = vld1q_f32(a + i + 12);
        float32x4_t vb4 = vld1q_f32(b + i + 12);
        sum1 = vmlaq_f32(sum1, va1, vb1);
        sum2 = vmlaq_f32(sum2, va2, vb2);
        sum3 = vmlaq_f32(sum3, va3, vb3);
        sum4 = vmlaq_f32(sum4, va4, vb4);
    }
    float32x4_t sum12 = vaddq_f32(sum1, sum2);
    float32x4_t sum34 = vaddq_f32(sum3, sum4);
    float32x4_t sum = vaddq_f32(sum12, sum34);
    float total = vaddvq_f32(sum);
    for (; i < d; ++i) total += a[i] * b[i];
    return 1.0f - total;
}

// 优化 A：双累加器 + 批量加载 8 float 
// 使用 vld1q_f32_x2 一次加载 8 个 float，减少加载指令条数
inline float inner_product_neon_optA(const float* a, const float* b, size_t d) {
    float32x4_t sum1 = vdupq_n_f32(0.0f);
    float32x4_t sum2 = vdupq_n_f32(0.0f);
    size_t i = 0;
    for (; i + 8 <= d; i += 8) {
        float32x4x2_t va = vld1q_f32_x2(a + i);
        float32x4x2_t vb = vld1q_f32_x2(b + i);
        sum1 = vmlaq_f32(sum1, va.val[0], vb.val[0]);
        sum2 = vmlaq_f32(sum2, va.val[1], vb.val[1]);
    }
    float32x4_t sum = vaddq_f32(sum1, sum2);
    float total = vaddvq_f32(sum);
    for (; i < d; ++i) total += a[i] * b[i];
    return 1.0f - total;
}

// 优化 B：四累加器 + 批量加载 16 float 
// 使用 vld1q_f32_x4 一次加载 16 个 float，四个累加器并行，达到最佳性能
inline float inner_product_neon_optB(const float* a, const float* b, size_t d) {
    float32x4_t sum1 = vdupq_n_f32(0.0f);
    float32x4_t sum2 = vdupq_n_f32(0.0f);
    float32x4_t sum3 = vdupq_n_f32(0.0f);
    float32x4_t sum4 = vdupq_n_f32(0.0f);
    size_t i = 0;
    for (; i + 16 <= d; i += 16) {
        float32x4x4_t va = vld1q_f32_x4(a + i);
        float32x4x4_t vb = vld1q_f32_x4(b + i);
        sum1 = vmlaq_f32(sum1, va.val[0], vb.val[0]);
        sum2 = vmlaq_f32(sum2, va.val[1], vb.val[1]);
        sum3 = vmlaq_f32(sum3, va.val[2], vb.val[2]);
        sum4 = vmlaq_f32(sum4, va.val[3], vb.val[3]);
    }
    float32x4_t sum12 = vaddq_f32(sum1, sum2);
    float32x4_t sum34 = vaddq_f32(sum3, sum4);
    float32x4_t sum = vaddq_f32(sum12, sum34);
    float total = vaddvq_f32(sum);
    for (; i < d; ++i) total += a[i] * b[i];
    return 1.0f - total;
}

// 优化 C：双累加器 + 批量加载 8 float + 软件预取
// 在优化 A 基础上加入预取指令，尝试隐藏访存延迟
inline float inner_product_neon_optC(const float* a, const float* b, size_t d) {
    float32x4_t sum1 = vdupq_n_f32(0.0f);
    float32x4_t sum2 = vdupq_n_f32(0.0f);
    size_t i = 0;
    for (; i + 8 <= d; i += 8) {
        __builtin_prefetch(a + i + 16, 0, 3);
        __builtin_prefetch(b + i + 16, 0, 3);
        float32x4x2_t va = vld1q_f32_x2(a + i);
        float32x4x2_t vb = vld1q_f32_x2(b + i);
        sum1 = vmlaq_f32(sum1, va.val[0], vb.val[0]);
        sum2 = vmlaq_f32(sum2, va.val[1], vb.val[1]);
    }
    float32x4_t sum = vaddq_f32(sum1, sum2);
    float total = vaddvq_f32(sum);
    for (; i < d; ++i) total += a[i] * b[i];
    return 1.0f - total;
}

//Flat-SIMD 搜索函数包装 
// 以下函数均调用上述内积实现，返回 top‑k 索引（最小距离优先的优先队列）

std::priority_queue<std::pair<float, uint32_t>> flat_search_simd(
    float* base, float* query, size_t base_number, size_t vecdim, size_t k) {
    std::priority_queue<std::pair<float, uint32_t>> q;
    for (size_t i = 0; i < base_number; ++i) {
        float dis = inner_product_neon(base + i * vecdim, query, vecdim);
        if (q.size() < k) q.push({dis, i});
        else if (dis < q.top().first) { q.push({dis, i}); q.pop(); }
    }
    return q;
}

